<script>

/* =========================
   BUILDING FILTER
========================= */

const filterButtons =
    document.querySelectorAll(".filter");

const buildCards =
    document.querySelectorAll(".build-card");


filterButtons.forEach(button => {

    button.addEventListener(
        "click",
        () => {

            filterButtons.forEach(
                btn =>
                    btn.classList.remove("active")
            );

            button.classList.add("active");

            const filter =
                button.dataset.filter;


            buildCards.forEach(card => {

                if (
                    filter === "all" ||
                    card.dataset.level === filter
                ) {

                    card.style.display = "";

                } else {

                    card.style.display = "none";

                }

            });

        }
    );

});


/* =========================
   BUILD PLANNER
========================= */

const createPlan =
    document.getElementById("createPlan");


createPlan.addEventListener(
    "click",
    () => {

        const name =
            document
                .getElementById("buildName")
                .value
                .trim();


        const style =
            document
                .getElementById("buildStyle")
                .value;


        const notes =
            document
                .getElementById("buildNotes")
                .value
                .trim();


        const result =
            document.getElementById("planResult");


        if (!name || !style) {

            result.textContent =
                "Please enter a build name and choose a style.";

            result.classList.add("show");

            return;

        }


        result.innerHTML = `

            <strong style="color:#6ee878;">
                Build Plan Created
            </strong>

            <br><br>

            <strong>
                Build:
            </strong>

            ${escapeHTML(name)}

            <br>

            <strong>
                Style:
            </strong>

            ${escapeHTML(style)}

            <br>

            <strong>
                Notes:
            </strong>

            ${escapeHTML(
                notes || "No notes added."
            )}

        `;


        result.classList.add("show");

    }
);


/* =========================
   TEXT SAFETY
========================= */

function escapeHTML(text) {

    const div =
        document.createElement("div");

    div.textContent = text;

    return div.innerHTML;

}

