<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Minecraft-guide | Building Guide</title>

<style>

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;

    background: #0b1510;
    color: #edf5ef;

    line-height: 1.6;
}

a {
    color: inherit;
    text-decoration: none;
}

button,
input,
textarea,
select {
    font: inherit;
}

/* =========================
   NAV
========================= */

.navbar {
    position: sticky;
    top: 0;
    z-index: 1000;

    background: rgba(10, 22, 14, 0.97);

    border-bottom: 1px solid #294a32;

    backdrop-filter: blur(8px);
}

.nav-container {
    max-width: 1250px;
    min-height: 70px;

    margin: auto;
    padding: 0 24px;

    display: flex;
    align-items: center;
    justify-content: space-between;
}

.logo {
    color: #6ee878;

    font-size: 21px;
    font-weight: 900;
}

.logo span {
    color: white;
}

.nav-links {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
}

.nav-links a {
    padding: 10px 13px;

    border-radius: 7px;

    color: #aebdb2;

    font-size: 14px;
    font-weight: 800;
}

.nav-links a:hover,
.nav-links a.active {
    background: #1a3621;
    color: #72e77b;
}

/* =========================
   HERO
========================= */

.hero {
    padding: 85px 24px;

    background:
        linear-gradient(
            rgba(5, 15, 8, 0.62),
            rgba(5, 15, 8, 0.94)
        ),
        url("images/minecraft-banner.jpg")
        center / cover;

    border-bottom: 1px solid #294a32;
}

.hero-container {
    max-width: 1250px;
    margin: auto;
}

.label {
    color: #6ee878;

    font-size: 12px;
    font-weight: 900;
    letter-spacing: 2px;
}

.hero h1 {
    margin: 10px 0 17px;

    font-size: clamp(45px, 7vw, 75px);
    line-height: 1;
}

.hero p {
    max-width: 720px;

    color: #b4c2b8;

    font-size: 18px;
}

/* =========================
   GENERAL
========================= */

.section {
    max-width: 1250px;

    margin: auto;
    padding: 80px 24px;
}

.section-heading {
    margin-bottom: 32px;
}

.section-heading h2 {
    margin-top: 7px;

    font-size: 38px;
}

.section-heading p {
    max-width: 700px;

    margin-top: 7px;

    color: #899a8e;
}

/* =========================
   FILTERS
========================= */

.filters {
    display: flex;
    flex-wrap: wrap;

    gap: 8px;

    margin-bottom: 30px;
}

.filter {
    padding: 9px 14px;

    background: #101c14;

    border: 1px solid #304b37;
    border-radius: 7px;

    color: #aab9af;

    cursor: pointer;

    font-weight: 900;
}

.filter:hover,
.filter.active {
    background: #68dd70;
    border-color: #68dd70;

    color: #071008;
}

/* =========================
   BUILD CARDS
========================= */

.build-grid {
    display: grid;

    grid-template-columns:
        repeat(3, minmax(0, 1fr));

    gap: 18px;
}

.build-card {
    padding: 25px;

    background: #101c14;

    border: 1px solid #294a32;
    border-radius: 11px;

    transition: 0.2s;
}

.build-card:hover {
    transform: translateY(-4px);

    border-color: #6ee878;
}

.build-icon {
    width: 49px;
    height: 49px;

    display: grid;
    place-items: center;

    margin-bottom: 17px;

    background: #193521;
    color: #6ee878;

    border-radius: 8px;

    font-weight: 900;
}

.build-card h3 {
    margin-bottom: 8px;
}

.build-card p {
    color: #899a8e;
}

.difficulty {
    display: inline-block;

    margin-top: 15px;
    padding: 5px 9px;

    background: #0b1510;

    border-radius: 5px;

    color: #70e77a;

    font-size: 10px;
    font-weight: 900;

    text-transform: uppercase;
}

/* =========================
   TUTORIAL
========================= */

.tutorial {
    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 20px;
}

.tutorial-card {
    padding: 27px;

    background: #101c14;

    border: 1px solid #294a32;
    border-radius: 11px;
}

.tutorial-card h3 {
    margin-bottom: 17px;

    font-size: 23px;
}

.steps {
    list-style: none;

    counter-reset: buildsteps;
}

.steps li {
    counter-increment: buildsteps;

    position: relative;

    padding: 12px 0 12px 42px;

    border-bottom: 1px solid #213628;

    color: #9ca99f;
}

.steps li::before {
    content: counter(buildsteps);

    position: absolute;

    left: 0;
    top: 9px;

    width: 28px;
    height: 28px;

    display: grid;
    place-items: center;

    background: #193521;

    border-radius: 50%;

    color: #6ee878;

    font-size: 12px;
    font-weight: 900;
}

/* =========================
   RULES
========================= */

.rules {
    display: grid;

    gap: 12px;
}

.rule {
    padding: 19px;

    background: #0c1710;

    border: 1px solid #263f2c;

    border-radius: 8px;
}

.rule strong {
    display: block;

    margin-bottom: 5px;

    color: #6ee878;
}

.rule p {
    color: #899a8e;
}

/* =========================
   PALETTES
========================= */

.palette-grid {
    display: grid;

    grid-template-columns:
        repeat(4, 1fr);

    gap: 15px;
}

.palette-card {
    padding: 20px;

    background: #101c14;

    border: 1px solid #294a32;
    border-radius: 10px;
}

.palette-card h3 {
    margin-bottom: 4px;
}

.palette-card p {
    color: #7f9085;

    font-size: 13px;
}

.blocks {
    display: flex;

    gap: 6px;

    margin-top: 17px;
}

.block {
    width: 35px;
    height: 35px;

    border-radius: 5px;

    background: #37463a;

    border: 1px solid #536456;
}

.block:nth-child(2) {
    background: #4b594c;
}

.block:nth-child(3) {
    background: #626b5e;
}

.block:nth-child(4) {
    background: #777c6e;
}

/* =========================
   TIPS
========================= */

.tips {
    display: grid;

    grid-template-columns: repeat(2, 1fr);

    gap: 17px;
}

.tip {
    padding: 23px;

    background: #101c14;

    border: 1px solid #294a32;
    border-radius: 10px;
}

.tip strong {
    display: block;

    margin-bottom: 6px;

    color: #6ee878;
}

.tip p {
    color: #899a8e;
}

/* =========================
   BUILD PLANNER
========================= */

.planner {
    padding: 35px;

    background:
        linear-gradient(
            135deg,
            #193521,
            #102518
        );

    border: 1px solid #3d6245;
    border-radius: 13px;
}

.planner h2 {
    margin-bottom: 8px;

    font-size: 31px;
}

.planner > p {
    margin-bottom: 24px;

    color: #acb9af;
}

.planner-form {
    display: grid;

    gap: 12px;
}

.planner-form input,
.planner-form textarea,
.planner-form select {
    width: 100%;

    padding: 13px 14px;

    background: #0b1510;

    border: 1px solid #38523e;
    border-radius: 7px;

    color: white;

    outline: none;
}

.planner-form textarea {
    min-height: 120px;

    resize: vertical;
}

.planner-form input:focus,
.planner-form textarea:focus,
.planner-form select:focus {
    border-color: #6ee878;
}

.plan-button {
    padding: 13px 18px;

    background: #68dd70;

    border: none;
    border-radius: 7px;

    color: #071008;

    cursor: pointer;

    font-weight: 900;
}

.plan-button:hover {
    background: #7beb83;
}

#planResult {
    display: none;

    margin-top: 18px;
    padding: 16px;

    background: #0b1510;

    border-radius: 7px;

    color: #aebbb1;
}

#planResult.show {
    display: block;
}

/* =========================
   FOOTER
========================= */

footer {
    padding: 35px 24px;

    background: #08100b;

    border-top: 1px solid #203728;
}

.footer-container {
    max-width: 1250px;

    margin: auto;

    display: flex;
    justify-content: space-between;

    gap: 20px;
}

.footer-container p {
    color: #6f8075;

    font-size: 13px;
}

.footer-links {
    display: flex;
    gap: 20px;
}

.footer-links a {
    color: #7f9085;

    font-size: 13px;
}

.footer-links a:hover {
    color: #6ee878;
}

/* =========================
   MOBILE
========================= */

@media (max-width: 900px) {

    .build-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .palette-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .tutorial {
        grid-template-columns: 1fr;
    }

}

@media (max-width: 650px) {

    .nav-container {
        flex-direction: column;

        padding: 14px 20px;

        gap: 10px;
    }

    .build-grid,
    .palette-grid,
    .tips {
        grid-template-columns: 1fr;
    }

    .planner {
        padding: 25px;
    }

    .footer-container {
        flex-direction: column;
    }

}

</style>

</head>

