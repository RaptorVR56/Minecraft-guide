/* ========================================================
   IMAGE SYSTEM
======================================================== */

function mobImage(mob) {

    return "https://minecraft.wiki/images/EntitySprite_" +
        mob.id +
        ".png";
}


/* ========================================================
   CREATE CARD
======================================================== */

function createCard(mob) {

    const card =
        document.createElement("article");

    card.className = "mob-card";

    card.innerHTML = `

        <div class="mob-image">

            <img
                src="${mobImage(mob)}"
                alt="${mob.name}"
                loading="lazy"
                onerror="this.style.display='none'"
            >

        </div>

        <div class="mob-info">

            <div class="mob-name">
                ${mob.name}
            </div>

            <div class="mob-id">
                minecraft:${mob.id}
            </div>

            <p class="mob-description">
                ${mob.description}
            </p>

            <div class="tags">

                <span class="tag ${mob.type}">
                    ${mob.type.toUpperCase()}
                </span>

                <span class="tag ${mob.dimension}">
                    ${mob.dimension.toUpperCase()}
                </span>

            </div>

            <div class="card-stats">

                <div class="card-stat">
                    <small>HEALTH</small>
                    <strong>${mob.health}</strong>
                </div>

                <div class="card-stat">
                    <small>ATTACK</small>
                    <strong>${mob.attack}</strong>
                </div>

            </div>

        </div>
    `;

    card.addEventListener(
        "click",
        () => openModal(mob)
    );

    return card;
}


/* ========================================================
   DISPLAY
======================================================== */

const grid =
    document.getElementById("mobGrid");

const noResults =
    document.getElementById("noResults");

let currentFilter = "all";

function displayMobs(list) {

    grid.innerHTML = "";

    list.forEach(mob => {

        grid.appendChild(
            createCard(mob)
        );

    });

    noResults.style.display =
        list.length === 0
            ? "block"
            : "none";
}


/* ========================================================
   SEARCH
======================================================== */

const search =
    document.getElementById("search");

function updateResults() {

    const query =
        search.value
            .toLowerCase()
            .trim();

    const filtered =
        mobs.filter(mob => {

            const searchable = (

                mob.name + " " +
                mob.id + " " +
                mob.type + " " +
                mob.dimension + " " +
                mob.health + " " +
                mob.attack + " " +
                mob.spawn + " " +
                mob.drops + " " +
                mob.description + " " +
                mob.special

            ).toLowerCase();

            const matchesSearch =
                searchable.includes(query);

            const matchesFilter =
                currentFilter === "all" ||
                mob.type === currentFilter ||
                mob.dimension === currentFilter;

            return (
                matchesSearch &&
                matchesFilter
            );

        });

    displayMobs(filtered);
}

search.addEventListener(
    "input",
    updateResults
);


/* ========================================================
   FILTER BUTTONS
======================================================== */

document
    .querySelectorAll(".filter")
    .forEach(button => {

        button.addEventListener(
            "click",
            () => {

                document
                    .querySelectorAll(".filter")
                    .forEach(btn =>
                        btn.classList.remove("active")
                    );

                button.classList.add("active");

                currentFilter =
                    button.dataset.filter;

                updateResults();
            }
        );

    });


/* ========================================================
   MODAL
======================================================== */

const modal =
    document.getElementById("modal");

const closeModalButton =
    document.getElementById("closeModal");

function openModal(mob) {

    document.getElementById(
        "modalTitle"
    ).textContent = mob.name;

    document.getElementById(
        "modalImage"
    ).src = mobImage(mob);

    document.getElementById(
        "modalImage"
    ).alt = mob.name;

    document.getElementById(
        "modalDescription"
    ).textContent =
        mob.description;

    document.getElementById(
        "modalSpecial"
    ).textContent =
        mob.special;

    document.getElementById(
        "modalSpawn"
    ).textContent =
        mob.spawn;

    document.getElementById(
        "modalDrops"
    ).textContent =
        mob.drops;

    document.getElementById(
        "modalDetails"
    ).innerHTML = `

        <div class="detail">
            <span class="detail-label">
                MOB ID
            </span>
            <span class="detail-value">
                minecraft:${mob.id}
            </span>
        </div>

        <div class="detail">
            <span class="detail-label">
                TYPE
            </span>
            <span class="detail-value">
                ${mob.type}
            </span>
        </div>

        <div class="detail">
            <span class="detail-label">
                DIMENSION
            </span>
            <span class="detail-value">
                ${mob.dimension}
            </span>
        </div>

        <div class="detail">
            <span class="detail-label">
                HEALTH
            </span>
            <span class="detail-value">
                ${mob.health}
            </span>
        </div>

        <div class="detail">
            <span class="detail-label">
                ATTACK
            </span>
            <span class="detail-value">
                ${mob.attack}
            </span>
        </div>

    `;

    modal.classList.add("open");

    document.body.style.overflow =
        "hidden";
}

function closeModal() {

    modal.classList.remove("open");

    document.body.style.overflow =
        "";
}

closeModalButton.addEventListener(
    "click",
    closeModal
);

modal.addEventListener(
    "click",
    event => {

        if (
            event.target === modal
        ) {
            closeModal();
        }

    }
);

document.addEventListener(
    "keydown",
    event => {

        if (
            event.key === "Escape"
        ) {
            closeModal();
        }

    }
);


/* ========================================================
   STATISTICS
======================================================== */

document.getElementById(
    "mobCount"
).textContent = mobs.length;

document.getElementById(
    "passiveCount"
).textContent =
    mobs.filter(
        mob => mob.type === "passive"
    ).length;

document.getElementById(
    "hostileCount"
).textContent =
    mobs.filter(
        mob => mob.type === "hostile"
    ).length;

document.getElementById(
    "bossCount"
).textContent =
    mobs.filter(
        mob => mob.type === "boss"
    ).length;


/* ========================================================
   START
======================================================== */

displayMobs(mobs);

</script>

</body>
</html>
