    >

    <div class="filter-title">
        MOB TYPE
    </div>

    <div class="filters">

        <button
            class="filter active"
            data-filter="all">
            All
        </button>

        <button
            class="filter"
            data-filter="passive">
            Passive
        </button>

        <button
            class="filter"
            data-filter="neutral">
            Neutral
        </button>

        <button
            class="filter"
            data-filter="hostile">
            Hostile
        </button>

        <button
            class="filter"
            data-filter="boss">
            Boss
        </button>

    </div>


    <div class="filter-title">
        DIMENSION
    </div>

    <div class="filters">

        <button
            class="filter"
            data-filter="overworld">
            Overworld
        </button>

        <button
            class="filter"
            data-filter="nether">
            Nether
        </button>

        <button
            class="filter"
            data-filter="end">
            End
        </button>

    </div>

</section>


<!-- =========================
     MOB CONTENT
========================= -->

<main class="container">

    <div
        class="mob-grid"
        id="mobGrid">
    </div>

    <div
        class="no-results"
        id="noResults">

        <h2>
            No mobs found
        </h2>

        <p>
            Try a different search or filter.
        </p>

    </div>

</main>


<!-- =========================
     MOB DETAILS MODAL
========================= -->

<div
    class="modal"
    id="modal">

    <div class="modal-box">

        <div class="modal-header">

            <div
                class="modal-title"
                id="modalTitle">
            </div>

            <button
                class="close"
                id="closeModal">
                ×
            </button>

        </div>

        <div class="modal-body">

            <div class="modal-top">

                <div class="modal-image">

                    <img
                        id="modalImage"
                        alt=""
                    >

                </div>

                <div>

                    <div
                        class="detail-grid"
                        id="modalDetails">
                    </div>

                </div>

            </div>


            <div class="modal-section">

                <h3>
                    Description
                </h3>

                <p id="modalDescription">
                </p>

            </div>


            <div class="modal-section">

                <h3>
                    Special Information
                </h3>

                <p id="modalSpecial">
                </p>

            </div>


            <div class="modal-section">

                <h3>
                    Spawn Information
                </h3>

                <p id="modalSpawn">
                </p>

            </div>


            <div class="modal-section">

                <h3>
                    Drops
                </h3>

                <p id="modalDrops">
                </p>

            </div>

        </div>

    </div>

</div>


<!-- =========================
     FOOTER
========================= -->

<footer>

    <p>
        <strong>Minecraft-guide</strong>
