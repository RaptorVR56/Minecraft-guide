<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Minecraft-guide | Mob Guide</title>

<style>

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: #0b1510;
    color: #edf5ef;
    line-height: 1.6;
}

button,
input {
    font: inherit;
}

a {
    color: inherit;
    text-decoration: none;
}

/* =========================
   NAV
========================= */

.navbar {
    position: sticky;
    top: 0;
    z-index: 1000;

    background: rgba(10, 22, 14, 0.97);

    border-bottom: 1px solid #294a32;

    backdrop-filter: blur(8px);
}

.nav-container {
    max-width: 1250px;
    min-height: 70px;

    margin: auto;
    padding: 0 24px;

    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    color: #6ee878;
    font-size: 21px;
    font-weight: 900;
}

.logo span {
    color: white;
}

.nav-links {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
}

.nav-links a {
    padding: 10px 13px;

    border-radius: 7px;

    color: #aebdb2;

    font-size: 14px;
    font-weight: 800;
}

.nav-links a:hover,
.nav-links a.active {
    background: #1a3621;
    color: #72e77b;
}

/* =========================
   HERO
========================= */

.hero {
    padding: 75px 24px;

    background:
        linear-gradient(
            rgba(5, 15, 8, 0.65),
            rgba(5, 15, 8, 0.94)
        ),
        url("images/minecraft-banner.jpg")
        center / cover;

    border-bottom: 1px solid #294a32;
}

.hero-container {
    max-width: 1250px;
    margin: auto;
}

.label {
    color: #6ee878;

    font-size: 12px;
    font-weight: 900;
    letter-spacing: 2px;
}

.hero h1 {
    margin: 9px 0 10px;

    font-size: clamp(45px, 7vw, 75px);
    line-height: 1;
}

.hero p {
    max-width: 720px;

    color: #b4c2b8;

    font-size: 17px;
}

/* =========================
   CONTROLS
========================= */

.controls {
    max-width: 1250px;

    margin: auto;
    padding: 30px 24px 10px;
}

.search {
    width: 100%;

    padding: 16px 17px;

    background: #101c14;

    border: 1px solid #35533c;
    border-radius: 8px;

    color: white;

    outline: none;
}

.search:focus {
    border-color: #6ee878;
}

.filters {
    display: flex;
    flex-wrap: wrap;

    gap: 8px;

    margin-top: 14px;
}

.filter {
    padding: 9px 14px;

    background: #101c14;

    border: 1px solid #304b37;
    border-radius: 7px;

    color: #aab9af;

    cursor: pointer;

    font-weight: 900;
}

.filter:hover,
.filter.active {
    background: #68dd70;
    border-color: #68dd70;

    color: #071008;
}

/* =========================
   RESULTS
========================= */

.results {
    max-width: 1250px;

    margin: auto;
    padding: 18px 24px;

    color: #718278;

    font-size: 13px;
    font-weight: 900;
}

/* =========================
   MOB GRID
========================= */

.mob-grid {
    max-width: 1250px;

    margin: auto;
    padding: 0 24px 80px;

    display: grid;

    grid-template-columns:
        repeat(4, minmax(0, 1fr));

    gap: 18px;
}

.mob-card {
    overflow: hidden;

    background: #101c14;

    border: 1px solid #294a32;
    border-radius: 10px;

    transition: 0.2s;
}

.mob-card:hover {
    transform: translateY(-4px);

    border-color: #6ee878;
}

.mob-image {
    height: 180px;

    display: grid;
    place-items: center;

    background:
        radial-gradient(
            circle,
            #23412b,
            #0c1710
        );

    overflow: hidden;
}

.mob-image img {
    width: 100%;
    height: 100%;

    object-fit: contain;

    image-rendering: pixelated;
}

.mob-image.image-missing::after {
    content: "IMAGE UNAVAILABLE";

    color: #65756b;

    font-size: 11px;
    font-weight: 900;
}

.mob-body {
    padding: 18px;
}

.mob-name {
    font-size: 20px;
    font-weight: 900;
}

.mob-type {
    display: inline-block;

    margin: 8px 0 14px;

    padding: 5px 8px;

    background: #193521;
    color: #70e77a;

    border-radius: 5px;

    font-size: 10px;
    font-weight: 900;

    text-transform: uppercase;
}

.mob-info {
    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 7px;
}

.info-box {
    padding: 8px;

    background: #0b1510;

    border-radius: 6px;
}

.info-label {
    display: block;

    color: #64756a;

    font-size: 9px;
    font-weight: 900;

    text-transform: uppercase;
}

.info-value {
    color: #d2ddd5;

    font-size: 12px;
    font-weight: 800;
}

.details-button {
    width: 100%;

    margin-top: 13px;
    padding: 10px;

    background: #193521;

    border: 1px solid #3a6043;
    border-radius: 6px;

    color: #70e77a;

    cursor: pointer;

    font-weight: 900;
}

.details-button:hover {
    background: #68dd70;
    color: #071008;
}

/* =========================
   EMPTY
========================= */

.empty {
    display: none;

    padding: 70px 20px;

    text-align: center;

    color: #708078;
}

.empty.show {
    display: block;
}

/* =========================
   MODAL
========================= */

.modal {
    position: fixed;
    inset: 0;

    z-index: 2000;

    display: none;
    place-items: center;

    padding: 20px;

    background: rgba(0, 0, 0, 0.82);
}

.modal.show {
    display: grid;
}

.modal-box {
    width: min(850px, 100%);
    max-height: 90vh;

    overflow-y: auto;

    background: #101c14;

    border: 1px solid #42654a;
    border-radius: 12px;
}

.modal-header {
    padding: 21px;

    display: flex;
    justify-content: space-between;
    align-items: center;

    border-bottom: 1px solid #294a32;
}

.modal-header h2 {
    font-size: 29px;
}

.close {
    width: 38px;
    height: 38px;

    border: none;
    border-radius: 6px;

    background: #193521;

    color: white;

    cursor: pointer;

    font-size: 21px;
}

.modal-content {
    padding: 24px;
}

.modal-image {
    height: 230px;

    margin-bottom: 22px;

    display: grid;
    place-items: center;

    background: #0b1510;

    border-radius: 9px;
}

.modal-image img {
    height: 100%;
    max-width: 100%;

    object-fit: contain;

    image-rendering: pixelated;
}

.detail-grid {
    display: grid;

    grid-template-columns: repeat(2, 1fr);

    gap: 10px;

    margin-bottom: 24px;
}

.detail {
    padding: 14px;

    background: #0b1510;

    border-radius: 7px;
}

.detail strong {
    display: block;

    margin-bottom: 3px;

    color: #6ee878;
}

.modal-content h3 {
    margin: 19px 0 7px;
}

.modal-content p {
    color: #9eaca2;
}

/* =========================
   FOOTER
========================= */

footer {
    padding: 35px 24px;

    background: #08100b;

    border-top: 1px solid #203728;
}

.footer-container {
    max-width: 1250px;

    margin: auto;

    display: flex;
    justify-content: space-between;
    gap: 20px;
}

.footer-container p {
    color: #6f8075;

    font-size: 13px;
}

.footer-links {
    display: flex;
    gap: 20px;
}

.footer-links a {
    color: #7f9085;

    font-size: 13px;
}

.footer-links a:hover {
    color: #6ee878;
}

/* =========================
   RESPONSIVE
========================= */

@media (max-width: 1050px) {

    .mob-grid {
        grid-template-columns: repeat(3, 1fr);
    }

}

@media (max-width: 800px) {

    .nav-container {
        flex-direction: column;

        padding: 14px 20px;

        gap: 10px;
    }

    .mob-grid {
        grid-template-columns: repeat(2, 1fr);
    }

}

@media (max-width: 500px) {

    .mob-grid {
        grid-template-columns: 1fr;
    }

    .detail-grid {
        grid-template-columns: 1fr;
    }

    .footer-container {
        flex-direction: column;
    }

}

</style>

</head>

