/* =========================
   PAGE LOGIC
========================= */

const grid =
    document.getElementById("mobGrid");

const search =
    document.getElementById("search");

const results =
    document.getElementById("results");

const empty =
    document.getElementById("empty");

const modal =
    document.getElementById("modal");

const closeModal =
    document.getElementById("closeModal");

let currentType = "All";


function mobImage(mob) {

    return `images/mobs/${mob.id}.png`;

}


function renderMobs() {

    const query =
        search.value
        .toLowerCase()
        .trim();

    const filtered =
        mobs.filter(mob => {

            const matchesSearch =
                mob.name
                .toLowerCase()
                .includes(query);

            const matchesType =
                currentType === "All" ||
                mob.type === currentType;

            return (
                matchesSearch &&
                matchesType
            );

        });


    grid.innerHTML = "";


    results.textContent =
        `${filtered.length} mob${filtered.length === 1 ? "" : "s"} found`;


    empty.classList.toggle(
        "show",
        filtered.length === 0
    );


    filtered.forEach(mob => {

        const card =
            document.createElement("article");

        card.className =
            "mob-card";


        card.innerHTML = `

            <div class="mob-image">

                <img
                    src="${mobImage(mob)}"
                    alt="${mob.name}"
                    loading="lazy"
                    onerror="
                        this.parentElement.classList.add('image-missing');
                        this.style.display='none';
                    "
                >

            </div>

            <div class="mob-body">

                <div class="mob-name">
                    ${mob.name}
                </div>

                <span class="mob-type">
                    ${mob.type}
                </span>

                <div class="mob-info">

                    <div class="info-box">

                        <span class="info-label">
                            Health
                        </span>

                        <span class="info-value">
                            ${mob.health}
                        </span>

                    </div>

                    <div class="info-box">

                        <span class="info-label">
                            Attack
                        </span>

                        <span class="info-value">
                            ${mob.attack}
                        </span>

                    </div>

                </div>

                <button
                    class="details-button"
                    data-id="${mob.id}"
                >
                    View Details
                </button>

            </div>

        `;


        card
            .querySelector(".details-button")
            .addEventListener(
                "click",
                () => openMob(mob.id)
            );


        grid.appendChild(card);

    });

}


function openMob(id) {

    const mob =
        mobs.find(
            item => item.id === id
        );

    if (!mob) return;


    document
        .getElementById("modalName")
        .textContent = mob.name;


    document
        .getElementById("modalType")
        .textContent = mob.type;


    document
        .getElementById("modalHealth")
        .textContent = mob.health;


    document
        .getElementById("modalAttack")
        .textContent = mob.attack;


    document
        .getElementById("modalHabitat")
        .textContent = mob.habitat;


    document
        .getElementById("modalDescription")
        .textContent = mob.description;


    document
        .getElementById("modalDrops")
        .textContent = mob.drops;


    const image =
        document.getElementById("modalImage");

    image.src =
        mobImage(mob);

    image.alt =
        mob.name;


    modal.classList.add("show");

}


function closeMob() {

    modal.classList.remove("show");

}


/* SEARCH */

search.addEventListener(
    "input",
    renderMobs
);


/* FILTERS */

document
    .querySelectorAll(".filter")
    .forEach(button => {

        button.addEventListener(
            "click",
            () => {

                document
                    .querySelectorAll(".filter")
                    .forEach(btn =>
                        btn.classList.remove("active")
                    );

                button.classList.add("active");

                currentType =
                    button.dataset.type;

                renderMobs();

            }
        );

    });


/* MODAL */

closeModal.addEventListener(
    "click",
    closeMob
);


modal.addEventListener(
    "click",
    event => {

        if (
            event.target === modal
        ) {
            closeMob();
        }

    }
);


document.addEventListener(
    "keydown",
    event => {

        if (
            event.key === "Escape"
        ) {
            closeMob();
        }

    }
);


/* INITIAL LOAD */

renderMobs();

</script>

