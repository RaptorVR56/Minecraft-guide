<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Minecraft Guide | Mob Encyclopedia</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Press+Start+2P&display=swap');

:root {
    --bg: #07110b;
    --bg2: #0b1b10;
    --card: #102719;
    --card2: #15341f;
    --border: #285a37;
    --green: #45b653;
    --green2: #2e873b;
    --light: #eef7ef;
    --muted: #a8b8ac;
    --gold: #e6c15a;
    --red: #e05252;
    --blue: #57a9e8;
    --purple: #b678e6;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    scroll-behavior: smooth;
}

body {
    background:
        radial-gradient(circle at top, rgba(69,182,83,.12), transparent 35%),
        var(--bg);
    color: var(--light);
    font-family: Inter, Arial, sans-serif;
    min-height: 100vh;
}

/* =========================
   NAVBAR
========================= */

.navbar {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: rgba(5,13,8,.96);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
}

.nav-inner {
    max-width: 1400px;
    margin: auto;
    padding: 17px 25px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.logo {
    color: white;
    text-decoration: none;
    font-family: "Press Start 2P", monospace;
    font-size: 15px;
}

.logo span {
    color: var(--green);
}

.nav-links {
    display: flex;
    gap: 25px;
}

.nav-links a {
    color: var(--muted);
    text-decoration: none;
    font-weight: 700;
}

.nav-links a:hover,
.nav-links a.active {
    color: var(--green);
}

/* =========================
   HERO
========================= */

.hero {
    max-width: 1400px;
    margin: auto;
    padding: 55px 25px 30px;
}

.hero-box {
    text-align: center;
    padding: 75px 30px;
    border-radius: 22px;
    border: 1px solid var(--border);

    background:
        linear-gradient(
            rgba(7,17,11,.35),
            rgba(7,17,11,.9)
        ),
        linear-gradient(
            135deg,
            #245a31,
            #0d2415
        );
}

.hero h1 {
    font-family: "Press Start 2P", monospace;
    font-size: clamp(25px, 5vw, 55px);
    line-height: 1.4;
}

.hero h1 span {
    color: var(--green);
}

.hero p {
    max-width: 800px;
    margin: 22px auto 0;
    color: var(--muted);
    font-size: 18px;
    line-height: 1.7;
}

.version {
    display: inline-block;
    margin-top: 25px;
    padding: 9px 15px;
    border: 1px solid var(--green);
    border-radius: 999px;
    color: #9df0a5;
    background: rgba(69,182,83,.1);
    font-size: 12px;
    font-weight: 800;
}

/* =========================
   STATS
========================= */

.stats {
    max-width: 1400px;
    margin: auto;
    padding: 0 25px 30px;

    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 15px;
}

.stat {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 13px;
    padding: 20px;
    text-align: center;
}

.stat-number {
    display: block;
    color: var(--green);
    font-size: 29px;
    font-weight: 800;
}

.stat-label {
    color: var(--muted);
    font-size: 13px;
    margin-top: 4px;
}

/* =========================
   CONTROLS
========================= */

.controls {
    max-width: 1400px;
    margin: auto;
    padding: 0 25px 35px;
}

.search {
    width: 100%;
    padding: 17px 19px;

    background: var(--card);
    color: white;

    border: 1px solid var(--border);
    border-radius: 11px;

    outline: none;
    font-size: 16px;
}

.search:focus {
    border-color: var(--green);
    box-shadow: 0 0 0 3px rgba(69,182,83,.12);
}

.filter-title {
    margin: 22px 0 10px;
    color: white;
    font-size: 13px;
    font-weight: 800;
}

.filters {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
}

.filter {
    cursor: pointer;

    padding: 9px 14px;

    color: var(--muted);
    background: var(--card);

    border: 1px solid var(--border);
    border-radius: 8px;

    font-weight: 700;
}

.filter:hover,
.filter.active {
    color: white;
    background: var(--green2);
    border-color: var(--green);
}

/* =========================
   MOB GRID
========================= */

.container {
    max-width: 1400px;
    margin: auto;
    padding: 0 25px 80px;
}

.mob-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
}

.mob-card {
    overflow: hidden;

    background:
        linear-gradient(
            145deg,
            var(--card2),
            var(--card)
        );

    border: 1px solid var(--border);
    border-radius: 15px;

    cursor: pointer;

    transition:
        transform .2s,
        border-color .2s,
        box-shadow .2s;
}

.mob-card:hover {
    transform: translateY(-5px);
    border-color: var(--green);

    box-shadow:
        0 15px 40px rgba(0,0,0,.35);
}

.mob-image {
    height: 190px;

    display: flex;
    justify-content: center;
    align-items: center;

    background:
        radial-gradient(
            circle,
            rgba(69,182,83,.14),
            transparent 65%
        ),
        #09180e;

    border-bottom: 1px solid var(--border);
}

.mob-image img {
    width: 145px;
    height: 145px;

    object-fit: contain;

    image-rendering: pixelated;
}

.mob-info {
    padding: 17px;
}

.mob-name {
    font-size: 20px;
    font-weight: 800;
}

.mob-id {
    margin-top: 3px;
    color: #77907e;
    font-size: 11px;
}

.mob-description {
    margin-top: 12px;

    color: var(--muted);

    font-size: 13px;
    line-height: 1.55;

    min-height: 61px;
}

.tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;

    margin-top: 13px;
}

.tag {
    padding: 5px 8px;

    border-radius: 5px;

    background: #1c4026;
    color: #a4e9ad;

    font-size: 10px;
    font-weight: 800;
}

.tag.hostile {
    color: #ff9c9c;
    background: rgba(224,82,82,.14);
}

.tag.neutral {
    color: #f2d374;
    background: rgba(230,193,90,.13);
}

.tag.boss {
    color: #e0a5ef;
    background: rgba(182,120,230,.13);
}

.tag.end {
    color: #c5a5f0;
}

.tag.nether {
    color: #ff9999;
}

.card-stats {
    margin-top: 14px;

    border-top: 1px solid var(--border);

    padding-top: 12px;

    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
}

.card-stat {
    background: rgba(0,0,0,.13);
    padding: 8px;
    border-radius: 6px;
}

.card-stat small {
    display: block;
    color: #718278;
    font-size: 10px;
}

.card-stat strong {
    display: block;
    margin-top: 2px;
    font-size: 12px;
}

/* =========================
   EMPTY
========================= */

.no-results {
    display: none;
    text-align: center;
    padding: 80px 20px;
}

.no-results h2 {
    margin-bottom: 8px;
}

.no-results p {
    color: var(--muted);
}

/* =========================
   MODAL
========================= */

.modal {
    position: fixed;
    inset: 0;

    z-index: 2000;

    display: none;

    align-items: center;
    justify-content: center;

    padding: 20px;

    background: rgba(0,0,0,.75);
    backdrop-filter: blur(8px);
}

.modal.open {
    display: flex;
}

.modal-box {
    width: min(850px, 100%);
    max-height: 90vh;

    overflow-y: auto;

    background: #0d2114;

    border: 1px solid var(--border);
    border-radius: 18px;

    box-shadow: 0 30px 80px rgba(0,0,0,.55);
}

.modal-header {
    padding: 25px;

    display: flex;
    justify-content: space-between;
    align-items: center;

    border-bottom: 1px solid var(--border);
}

.modal-title {
    font-size: 28px;
    font-weight: 800;
}

.close {
    border: 0;
    background: transparent;
    color: var(--muted);

    font-size: 28px;

    cursor: pointer;
}

.close:hover {
    color: white;
}

.modal-body {
    padding: 25px;
}

.modal-top {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 25px;
}

.modal-image {
    min-height: 220px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 12px;

    background:
        radial-gradient(
            circle,
            rgba(69,182,83,.15),
            transparent
        ),
        #08170d;

    border: 1px solid var(--border);
}

.modal-image img {
    width: 180px;
    height: 180px;

    object-fit: contain;

    image-rendering: pixelated;
}

.detail-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
}

.detail {
    padding: 12px;

    background: rgba(255,255,255,.025);

    border: 1px solid var(--border);
    border-radius: 8px;
}

.detail-label {
    display: block;
    color: #718278;
    font-size: 11px;
    margin-bottom: 4px;
}

.detail-value {
    font-weight: 700;
    font-size: 13px;
}

.modal-section {
    margin-top: 25px;
}

.modal-section h3 {
    margin-bottom: 9px;
    color: var(--green);
}

.modal-section p {
    color: var(--muted);
    line-height: 1.7;
}

/* =========================
   FOOTER
========================= */

footer {
    padding: 35px 20px;

    text-align: center;

    border-top: 1px solid var(--border);

    background: #040a06;

    color: var(--muted);
}

footer strong {
    color: var(--green);
}

/* =========================
   RESPONSIVE
========================= */

@media(max-width:1100px) {

    .mob-grid {
        grid-template-columns: repeat(3,1fr);
    }
}

@media(max-width:800px) {

    .mob-grid {
        grid-template-columns: repeat(2,1fr);
    }

    .stats {
        grid-template-columns: repeat(2,1fr);
    }

    .nav-links {
        display: none;
    }

    .modal-top {
        grid-template-columns: 1fr;
    }
}

@media(max-width:520px) {

    .mob-grid {
        grid-template-columns: 1fr;
    }

    .hero-box {
        padding: 50px 18px;
    }

    .stats {
        grid-template-columns: 1fr 1fr;
    }

    .detail-grid {
        grid-template-columns: 1fr;
    }
}
</style>
</head>

